# ─── LLM provider (LLMod.ai, OpenAI-compatible) ──────────────────────────────
# Base URL must be the root that serves /chat/completions and /embeddings.
LLMOD_BASE_URL=https://api.llmod.ai/v1
LLMOD_API_KEY=
LLM_TEXT_MODEL=MB5R2CF-azure/gpt-5.4-mini
LLM_EMBED_MODEL=MB5R2CF-azure/text-embedding-3-small

# ─── Supabase (profile cache, session/HITL state, run history) ───────────────
# Optional: without these ConfFit falls back to an in-process store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Pinecone (RAG over CFP chunks + past accepted papers) ───────────────────
# Optional: without these ConfFit falls back to an in-process vector store.
PINECONE_API_KEY=
PINECONE_INDEX=conffit

# ─── Agent tuning ────────────────────────────────────────────────────────────
# Reflection iterations for FramingAgent (hard-capped at 2 by the code).
FRAMING_REFLECT_MAX=1
# Set to 1 to run the whole system against a deterministic stub LLM (no cost).
MOCK_LLM=0
